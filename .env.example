# Fonte das perguntas do quiz (Google Sheets publicado como CSV).
# Copie para .env.local e preencha. Se nada for definido, o build usa o
# questions.json existente como fallback.

# Opção A — URL completa do CSV publicado
# (Google Sheets > Arquivo > Compartilhar > Publicar na web > aba > CSV)
QUIZ_SHEET_CSV_URL=

# Opção B — ID da planilha (+ GID da aba, opcional, padrão 0)
# QUIZ_SHEET_ID=
# QUIZ_SHEET_GID=0
